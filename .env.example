# Skyward Monorepo Shared Environment Configuration

# Backend API Configuration (apps/api)
# Dibaca oleh apps/api/internal/config/config.go. Semua milik backend
# memakai prefix SKYWARD_ (kecuali PORT/HOST/DATABASE_URL/CORS_ALLOWED_ORIGINS).
SKYWARD_ENV=dev
PORT=8090
HOST=127.0.0.1
DATABASE_URL=postgres://qouver:qouver_pass@localhost:5432/skyward_dev?sslmode=disable
SKYWARD_JWT_SECRET=dev-secret-key-change-in-production-12345
SKYWARD_LOG_LEVEL=debug
# SKYWARD_LOG_DIR=/var/log/skyward
# SKYWARD_ADMIN_TOKEN=            # WAJIB di prod; kosong = /admin/* mati (503)
# CORS_ALLOWED_ORIGINS=https://skyward.qouver.com
# SKYWARD_TRUSTED_PROXIES=127.0.0.0/8,::1
# SKYWARD_RATE_LIMIT_PER_MIN=2400
# SKYWARD_WORKER_ENABLED=true
# SKYWARD_WORKER_TICK_INTERVAL_SECONDS=60
# PUBLIC_BASE_URL=

# Frontend App Configuration (apps/app)
# Dibaca envied dari lib/core/config/app_env.dart (varName SKYWARD_API_URL).
SKYWARD_API_URL=http://localhost:8090
