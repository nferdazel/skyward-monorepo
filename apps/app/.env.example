# Skyward Flutter app — env template (dibaca envied via `dart run build_runner build`)
# Salin ke apps/app/.env lalu regenerate app_env.g.dart:
#   cp .env.example .env && dart run build_runner build --delete-conflicting-outputs
#
# Kalau dibiarkan placeholder (YOUR_*), app masuk dev mode (mock data).

# ── Supabase (masih dipakai sampai migrasi ke Go API selesai — lihat
#    docs/plans/flutter-go-api-connection-plan.md) ──
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_KEY=YOUR_SUPABASE_KEY

# ── skyward-api (Go REST) — Phase 1+ ──
# Lokal: http://localhost:8090 (make dev-api). Prod web: dikirim via build arg
# dari env VPS (/srv/qouver/apps/skyward/env/skyward-prod.env) → https://api.qouver.com/skyward
SKYWARD_API_URL=http://localhost:8090
