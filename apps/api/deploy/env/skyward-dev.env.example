# Skyward DEV — env template
# Salin ke VPS: /srv/qouver/skyward/env/skyward-dev.env (chmod 600)
# Ganti CHANGE_ME dengan nilai sebenarnya.
# Secret TIDAK pernah di commit — hanya di VPS (mode 600).

SKYWARD_ENV=dev
PORT=8091
# Ganti CHANGE_ME dengan password skyward_app; host = nama container podman
DATABASE_URL=postgres://skyward_app:CHANGE_ME@qouver-postgres:5432/skyward_dev
PUBLIC_BASE_URL=https://api.qouver.com/skyward-dev
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://skyward-dev.vercel.app,https://*.vercel.app
SKYWARD_RATE_LIMIT_PER_MIN=120
SKYWARD_LOG_DIR=/logs
SKYWARD_LOG_LEVEL=debug
# Dev: AdminToken dan JWTSecret boleh kosong di dev (endpoint admin ditolak 401)
# SKYWARD_ADMIN_TOKEN=
# SKYWARD_JWT_SECRET= (min 32 chars — wajib untuk auth)