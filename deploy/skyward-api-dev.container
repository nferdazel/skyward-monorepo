# Quadlet unit untuk skyward-api (DEV instance).
# Pasang di VPS: ~/.config/containers/systemd/skyward-api-dev.container
# lalu: systemctl --user daemon-reload && systemctl --user enable --now skyward-api-dev
#
# - Volume /logs untuk log harian (mapping keep-id uid 10001)
# - PublishPort=127.0.0.1:8091:8091
# - EnvironmentFile = env secret (mode 600)

[Unit]
Description=Skyward API (dev, DB skyward_dev)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/nferdazel/skyward-api:dev
ContainerName=skyward-api-dev
Network=qouver
PublishPort=127.0.0.1:8091:8091
Pull=always
EnvironmentFile=/srv/qouver/skyward/env/skyward-dev.env
Volume=/srv/qouver/skyward/logs:/logs:Z
UserNS=keep-id:uid=10001
AutoUpdate=registry

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=default.target