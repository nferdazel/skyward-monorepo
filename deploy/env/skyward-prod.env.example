# Skyward PROD — env template
# Salin ke VPS: /srv/qouver/apps/skyward/env/skyward-prod.env (chmod 600)
# Ganti CHANGE_ME dengan nilai sebenarnya.
# Secret TIDAK pernah di commit — hanya di VPS (mode 600).

SKYWARD_ENV=prod
PORT=8090
DATABASE_URL=postgres://skyward_app:CHANGE_ME@qouver-postgres:5432/skyward
PUBLIC_BASE_URL=https://api.qouver.com/skyward
CORS_ALLOWED_ORIGINS=https://skyward.vercel.app
SKYWARD_RATE_LIMIT_PER_MIN=120
SKYWARD_LOG_DIR=/logs
SKYWARD_LOG_LEVEL=info
# Wajib diisi (validasi prod gagal kalau kosong)
SKYWARD_ADMIN_TOKEN=CHANGE_ME
SKYWARD_JWT_SECRET=CHANGE_ME_min_32_chars_long_string_here
SKYWARD_WORKER_ENABLED=true
SKYWARD_WORKER_TICK_INTERVAL_SECONDS=60