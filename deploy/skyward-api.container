# Quadlet unit untuk skyward-api (PROD instance).
# Pasang di VPS: ~/.config/containers/systemd/skyward-api.container
# lalu: systemctl --user daemon-reload && systemctl --user enable --now skyward-api
# (pastikan: loginctl enable-linger sachiel)
#
# - Network=qouver (satu bridge dengan qouver-postgres)
# - PublishPort=127.0.0.1:8090:8090 → Caddy proxy ke host
# - EnvironmentFile = env secret (mode 600)
# - Image public dari ghcr.io (tanpa auth)

[Unit]
Description=Skyward API (prod, DB skyward)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/nferdazel/skyward-api:main
ContainerName=skyward-api
Network=qouver
PublishPort=127.0.0.1:8090:8090
Pull=always
EnvironmentFile=/srv/qouver/skyward/env/skyward-prod.env
AutoUpdate=registry

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=default.target